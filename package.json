{
  "name": "research-swarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker:dev": "tsx watch worker/runner.ts",
    "worker:start": "tsx worker/runner.ts",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start -x edge-runtime --yes",
    "supabase:stop": "supabase stop",
    "supabase:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-local-env.ps1",
    "supabase:reset": "supabase db reset",
    "test:db": "supabase test db --local supabase/tests/academic_swarm.sql"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.25.0",
    "mammoth": "1.12.0",
    "next": "16.2.10",
    "openai": "6.48.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.6.0",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
